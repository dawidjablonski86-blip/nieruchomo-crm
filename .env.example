# Skopiuj ten plik jako ".env" i uzupełnij wartościami z panelu Supabase
# (Project Settings -> API oraz Project Settings -> Database)

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API -> Project API keys -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> Database -> Connection string -> "Transaction" pooler (port 6543)
# dopisz na końcu ?pgbouncer=true
DATABASE_URL=

# Project Settings -> Database -> Connection string -> "Session" / direct (port 5432)
# używane tylko przez `prisma migrate`
DIRECT_URL=
